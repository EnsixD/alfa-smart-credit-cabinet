# Скопируйте в .env при необходимости. Все переменные имеют значения по умолчанию.
POSTGRES_PASSWORD=credit
JWT_SECRET=change-me-in-production
# Пауза между шагами конвейера (сек), чтобы движение статусов было видно вживую
PIPELINE_STEP_DELAY_S=1.5
WORKER_REPLICAS=1
# LLM-ассистент (open-weights через Ollama). Включать вместе с: docker compose --profile ai up
LLM_ENABLED=false
LLM_MODEL=qwen2.5:1.5b
# Ollama вне Docker (установлена на компьютер): LLM_URL=http://host.docker.internal:11434
LLM_URL=http://ollama:11434
